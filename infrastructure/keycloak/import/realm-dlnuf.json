  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_VIEW\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"Numéro de téléphone\", \"validations\": {\"length\": {\"min\": 8, \"max\": 15}, \"pattern\": {\"pattern\": \"^[0-9]+$\", \"error-message\": \"Chiffres uniquement, ex. 22670000001\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"admin\", \"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"admin\", \"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"identifiant_pivot\", \"displayName\": \"Identifiant pivot (référence de l'acte de naissance)\", \"validations\": {\"pattern\": {\"pattern\": \"^ACTE:[A-Z]+:[0-9]{4}:[0-9]{5}$\", \"error-message\": \"Format attendu : ACTE:COMMUNE:AAAA:NNNNN\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"identification\"}, {\"name\": \"niveau_garantie\", \"displayName\": \"Niveau de garantie de l'identification (1 à 3)\", \"validations\": {\"options\": {\"options\": [\"1\", \"2\", \"3\"]}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"identification\"}, {\"name\": \"administration\", \"displayName\": \"Administration de rattachement (identifiant X-Road)\", \"validations\": {\"pattern\": {\"pattern\": \"^[A-Z]+/[A-Z]+/[A-Z0-9-]+$\", \"error-message\": \"Ex. BF/GOV/ONI\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"rattachement\"}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}, {\"name\": \"identification\", \"displayHeader\": \"Identification de l'usager\", \"displayDescription\": \"Renseigné par l'administration, jamais modifiable par l'usager\"}, {\"name\": \"rattachement\", \"displayHeader\": \"Rattachement\", \"displayDescription\": \"Administration des agents et administrateurs\"}]}"
          ]
