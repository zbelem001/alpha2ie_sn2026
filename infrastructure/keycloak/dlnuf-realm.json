{
  "realm": "dlnuf",
  "enabled": true,
  "displayName": "Dites-le-nous une fois (démo)",
  "roles": {
    "realm": [
      { "name": "agent", "description": "Agent d’une administration demandeuse" },
      { "name": "citizen", "description": "Citoyen propriétaire de ses données" }
    ]
  },
  "clientScopes": [
    {
      "name": "administration-code",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "administration_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "administration_code",
            "claim.name": "administration_code",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "citizen-ref",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "citizen_ref",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "citizen_ref",
            "claim.name": "citizen_ref",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "backend-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "dlnuf-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dlnuf-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "application-roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "usermodel.realmRoleMapping.rolePrefix": "",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "dlnuf-api",
      "name": "Dites-le-nous une fois API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8000/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:8000"],
      "defaultClientScopes": ["administration-code", "citizen-ref", "backend-audience", "application-roles"]
    }
  ],
  "users": [
    {
      "username": "agent-demo",
      "firstName": "Agent",
      "lastName": "Demo",
      "email": "agent-demo@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "administration_code": ["BF/GOV/FONCTION-PUBLIQUE"] },
      "credentials": [{ "type": "password", "value": "AgentDemo-2026!", "temporary": false }],
      "realmRoles": ["agent"]
    },
    {
      "username": "citoyen-demo",
      "firstName": "Citoyen",
      "lastName": "Demo",
      "email": "citoyen-demo@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "citizen_ref": ["ACTE:OUAGA:2004:01234"] },
      "credentials": [{ "type": "password", "value": "CitoyenDemo-2026!", "temporary": false }],
      "realmRoles": ["citizen"]
    }
  ]
}
