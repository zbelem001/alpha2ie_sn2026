# Valeurs par défaut de l'environnement de développement (aucun secret réel).
# Pour les modifier : copier en .env (ignoré par git) puis `docker compose up -d --build`.
# Pas de commentaire en fin de ligne : Compose le prendrait pour la valeur d'une variable vide.

# PostgreSQL (port 55432 sur la machine : 5432 est souvent déjà pris)
POSTGRES_USER=dlnuf
POSTGRES_PASSWORD=dlnuf-dev
POSTGRES_HOST_PORT=55432

# Keycloak (console : http://localhost:8180/admin). Détails : infrastructure/keycloak/README.md
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev
KEYCLOAK_HOST_PORT=8180
# Valeurs à reprendre par le frontend et le backend (realm importé depuis infrastructure/keycloak/import)
KEYCLOAK_ISSUER=http://localhost:8180/realms/dlnuf
# KEYCLOAK_JWKS_URL : depuis un conteneur ; depuis la machine, remplacer keycloak:8080 par localhost:8180
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/dlnuf/protocol/openid-connect/certs
KEYCLOAK_FRONTEND_CLIENT_ID=dlnuf-frontend
KEYCLOAK_FRONTEND_CLIENT_SECRET=dev-frontend-secret-a-changer
KEYCLOAK_BACKEND_AUDIENCE=dlnuf-backend

# Registres simulés
# REFERENCE_DATE : AAAA-MM-JJ pour figer « aujourd'hui » pendant une démo (vide = date réelle)
REFERENCE_DATE=
# SIMULATED_LATENCY_MS : latence ajoutée à chaque réponse, pour tester les délais d'attente
SIMULATED_LATENCY_MS=0

# Connecteur utilisé par le backend : direct ou xroad
REGISTRY_CONNECTOR=direct
REGISTRY_TIMEOUT_S=3
XROAD_CLIENT_ID=BF/GOV/ONI/CNIB
# XROAD_SECURITY_SERVER_URL : phase 3, ex. http://ss-oni:8080
XROAD_SECURITY_SERVER_URL=
