# Configuration de démonstration chargée directement par Docker Compose.
# Utiliser uniquement avec les données fictives fournies dans le projet.

# PostgreSQL et accès
POSTGRES_USER=dlnuf
POSTGRES_PASSWORD=dlnuf-dev
POSTGRES_HOST_PORT=55432
REGISTRY_CIVIL_PASSWORD=0CSa9ksQ0wDQdMm5A-uQK6etZv-QDiw0q7_0BomQStA
REGISTRY_JUSTICE_PASSWORD=RsOV7_ISraG8IL9COKpDGFSUnV4filt-axmY3HW1Xbg
REGISTRY_TREASURY_PASSWORD=hAzdMVl4oV9ipiRtLsBcTDHkIjhZ3ZymJ3kuwwAyLBo

# Keycloak, démonstration HTTP locale
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev
KEYCLOAK_HOST_PORT=8180
KEYCLOAK_ISSUER=http://localhost:8180/realms/dlnuf
KEYCLOAK_CLIENT_ID=dlnuf-api
KEYCLOAK_REALM=dlnuf
KEYCLOAK_SSL_REQUIRED=none
