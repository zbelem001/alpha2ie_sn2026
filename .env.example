KEYCLOAK_ADMIN_CLIENT_SECRET=F_Hc69fjzl7xmtzVM4yIuzkswSB_oUV8qOKAOzUlu4LJX2F1JWT_QrgZe1hyaRwa

# Comptes administrateurs de démonstration (PIN partagé)
DEMO_AGENT_PHONE=70000000
DEMO_PASSPORT_AGENT_PHONE=60000000
DEMO_LOCAL_ADMIN_PHONE=50000000
DEMO_ADMIN_PIN=1234

# Registres simulés
REFERENCE_DATE=
SIMULATED_LATENCY_MS=0

# Journal et consentement : jetons locaux de démonstration
JOURNAL_TOKEN_DEMARCHES=dev-journal-demarches
JOURNAL_TOKEN_CONSENTEMENT=dev-journal-consentement
JOURNAL_TOKEN_AUDITEUR=dev-journal-auditeur
CONSENT_TOKEN_DEMARCHES=dev-consentement-demarches

# Échanges X-Road et configuration obligatoire du banc local
REGISTRY_CONNECTOR=xroad
REGISTRY_TIMEOUT_S=3
REGISTRY_RETRY_INTERVAL_S=15
REGISTRY_RETRY_MAX_ATTEMPTS=20
XROAD_CLIENT_ID=BF/GOV/ONI/CNIB
XROAD_CLIENTS=BF/GOV/FONCTION-PUBLIQUE=BF/GOV/FONCTION-PUBLIQUE/RECRUTEMENT
XROAD_SECURITY_SERVER_URL=http://ss-demandeurs:8080
XROAD_TOKEN_PIN=Secret1234
XROAD_ADMIN_USER=xrd
XROAD_ADMIN_PASSWORD=secret
XROAD_CS_ADMIN_PORT=4100
XROAD_SS_REGISTRES_ADMIN_PORT=4101
XROAD_SS_DEMANDEURS_ADMIN_PORT=4102
XROAD_SS_DEMANDEURS_CLIENT_PORT=8280
XROAD_SYNC_ENABLED=true
XROAD_ADMIN_URL=https://ss-registres:4000
XROAD_ADMIN_URL_SS_REGISTRES=https://ss-registres:4000
XROAD_ADMIN_URL_SS_DEMANDEURS=https://ss-demandeurs:4000
XROAD_SECURITY_SERVER_URL_SS_REGISTRES=http://ss-registres:8080
XROAD_SECURITY_SERVER_URL_SS_DEMANDEURS=http://ss-demandeurs:8080

# SMS : simulation locale ; aucun appel Infobip n'est effectué
SMS_PROVIDER=simulated
OTP_SIMULATION_EXPOSE_CODE=true
OTP_SIMULATION_SECRET=demo-only-otp-simulation-secret-not-for-production
TEST_PHONE_NUMBER=+22670000001
CITIZEN_DEMO_PHONE_VERIFIED=true

