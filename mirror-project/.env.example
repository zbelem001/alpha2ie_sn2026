# Valeurs par défaut de l'environnement de développement (aucun secret réel).
# Pour les modifier : copier en .env (ignoré par git) puis `docker compose up -d --build`.
# Pas de commentaire en fin de ligne : Compose le prendrait pour la valeur d'une variable vide.

# Banc X-Road (5,3 Go de mémoire en plus) : décommenter dans .env pour qu'un simple
# `docker compose up -d --build` le démarre et le configure aussi.
# COMPOSE_PROFILES=xroad

# PostgreSQL (port 55432 sur la machine : 5432 est souvent déjà pris)
POSTGRES_USER=dlnuf
POSTGRES_PASSWORD=dlnuf-dev
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql+psycopg://dlnuf:dlnuf-dev@localhost:55432/backend

# Keycloak (console : http://localhost:8180)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev
KEYCLOAK_HOST_PORT=8180
KEYCLOAK_ISSUER=http://localhost:8180/realms/dlnuf
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/dlnuf/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=dlnuf-api
KEYCLOAK_REALM=dlnuf
# Client confidentiel réservé à la gestion limitée des comptes agents (service account).
KEYCLOAK_ADMIN_CLIENT_ID=dlnuf-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Registres simulés
# REFERENCE_DATE : AAAA-MM-JJ pour figer « aujourd'hui » pendant une démo (vide = date réelle)
REFERENCE_DATE=
# SIMULATED_LATENCY_MS : latence ajoutée à chaque réponse, pour tester les délais d'attente
SIMULATED_LATENCY_MS=0

# Notifications simulées (boîte d'envoi et téléphones : http://localhost:8107)
# NOTIFICATION_SERVICE_URL : adresse utilisée par le backend depuis un conteneur ; hors Docker, http://localhost:8107
NOTIFICATION_SERVICE_URL=http://notifications:8000
# NOTIFICATION_REPLY_WEBHOOK_URL : route du backend qui reçoit les réponses SMS, ex. http://backend:8000/webhooks/sms-replies (vide = le backend lit GET /replies)
NOTIFICATION_REPLY_WEBHOOK_URL=

# Connecteur utilisé par le backend : direct ou xroad
REGISTRY_CONNECTOR=direct
REGISTRY_TIMEOUT_S=3
# XROAD_CLIENT_ID : demandeur ; BF/GOV/ONI/CNIB ou BF/GOV/FONCTION-PUBLIQUE/RECRUTEMENT sur le banc
XROAD_CLIENT_ID=BF/GOV/ONI/CNIB
# XROAD_SECURITY_SERVER_URL : avec le banc X-Road (docker compose --profile xroad), http://ss-demandeurs:8080 depuis un conteneur, http://localhost:8280 depuis la machine
XROAD_SECURITY_SERVER_URL=

# SMS de consentement (simulation par défaut; secrets Infobip dans .env local uniquement)
SMS_PROVIDER=simulated
# En simulation locale, expose le code de démonstration dans la réponse API pour le saisir dans le champ OTP.
OTP_SIMULATION_EXPOSE_CODE=true
# Clé utilisée pour dériver et vérifier les OTP de démonstration (32 caractères au moins).
# Miroir : valeur de démonstration versionnée pour que `docker compose up` suffise ; en simulation, les codes
# sont de toute façon affichés (OTP_SIMULATION_EXPOSE_CODE). Hors démonstration : vraie clé dans .env, non versionnée.
OTP_SIMULATION_SECRET=demo-only-otp-simulation-secret-not-for-production
# Clé Infobip autorisée pour la 2FA : consentement assisté et inscription citoyen
INFOBIP_OTP_API_KEY=
# Clé Infobip autorisée pour l’API d’envoi de SMS simples
INFOBIP_SMS_API_KEY=
INFOBIP_BASE_URL=2yekxz.api.infobip.com
INFOBIP_SENDER=
# En mode test, tous les SMS sont redirigés vers ce numéro Infobip vérifié.
# Miroir : numéro fictif du compte citoyen-demo (Awa) ; avec SMS_PROVIDER=simulated, aucun SMS n'est envoyé.
TEST_PHONE_NUMBER=+22670000001
# IDs générés par Infobip : créer l’application 2FA et ses deux modèles SMS
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_CONSENT_MESSAGE_ID=
INFOBIP_2FA_REGISTRATION_MESSAGE_ID=
# Miroir : numéro fictif considéré comme vérifié, pour que citoyen-demo puisse rattacher son identité.
CITIZEN_DEMO_PHONE_VERIFIED=true

# Chiffrement des identifiants de documents citoyens (clé Fernet, à générer une fois)
# Miroir : clé de démonstration versionnée, pour que `docker compose up` suffise. Elle ne protège que des
# données fictives ; hors démonstration, générer une vraie clé dans .env, non versionnée.
CITIZEN_IDENTIFIER_ENCRYPTION_KEY=e_uCWKdRtpbn9mftWHlGC8dsLRnBVYPXHoLW2usDKOQ=
