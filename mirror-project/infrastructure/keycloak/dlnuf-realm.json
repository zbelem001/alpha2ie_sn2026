{
  "realm": "dlnuf",
  "enabled": true,
  "displayName": "Dites-le-nous une fois (démo)",
  "roles": {
    "realm": [
      { "name": "agent", "description": "Agent d’une administration demandeuse" },
      { "name": "citizen", "description": "Citoyen propriétaire de ses données" },
      { "name": "local-admin", "description": "Administrateur habilité de son administration locale" }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "Identité stable du compte : sub, preferred_username, name. Sans elle, le backend retombait sur jti, qui change à chaque jeton.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": { "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "administration-code",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "administration_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "administration_code",
            "claim.name": "administration_code",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "citizen-ref",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "citizen_ref",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "citizen_ref",
            "claim.name": "citizen_ref",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "citizen-phone-number",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "phone_number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phone_number",
            "claim.name": "phone_number",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "phone_number_verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phone_number_verified",
            "claim.name": "phone_number_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "backend-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "dlnuf-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dlnuf-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "application-roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "usermodel.realmRoleMapping.rolePrefix": "",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "dlnuf-api",
      "name": "Dites-le-nous une fois API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8000/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:8000"],
      "defaultClientScopes": ["basic", "administration-code", "citizen-ref", "citizen-phone-number", "backend-audience", "application-roles"]
    }
  ],
  "users": [
    {
      "username": "70000000",
      "firstName": "Agent",
      "lastName": "Demo",
      "email": "agent-demo@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "administration_code": ["BF/GOV/FONCTION-PUBLIQUE"], "account_kind": ["local-admin"], "phone_number": ["+22670000000"], "phone_number_verified": ["false"] },
      "credentials": [{ "type": "password", "value": "1234", "temporary": false }],
      "realmRoles": ["local-admin"]
    },
    {
      "username": "60000000",
      "firstName": "Agent Passeport",
      "lastName": "Demo",
      "email": "agent-passeport-demo@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "administration_code": ["BF/GOV/DIPF/PASSEPORTS"], "account_kind": ["local-admin"], "phone_number": ["+22660000000"], "phone_number_verified": ["false"] },
      "credentials": [{ "type": "password", "value": "1234", "temporary": false }],
      "realmRoles": ["local-admin"]
    },
    {
      "username": "citoyen-demo",
      "firstName": "Citoyen",
      "lastName": "Demo",
      "email": "citoyen-demo@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {},
      "credentials": [{ "type": "password", "value": "CitoyenDemo-2026!", "temporary": false }],
      "realmRoles": ["citizen"]
    },
    {
      "username": "50000000",
      "firstName": "Administrateur local",
      "lastName": "Passeport Demo",
      "email": "50000000@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "administration_code": ["BF/GOV/DIPF/PASSEPORTS"], "account_kind": ["local-admin"], "phone_number": ["+22650000000"], "phone_number_verified": ["false"] },
      "credentials": [{ "type": "password", "value": "1234", "temporary": false }],
      "realmRoles": ["local-admin"]
    }
  ]
}
